"use client";

import { useEffect, useMemo, useState } from "react";
import { createClient } from "@supabase/supabase-js";

const supabase = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL!,
  process.env.NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY!,
  {
    auth: {
      flowType: "pkce",
      persistSession: true,
      autoRefreshToken: true,
    },
  }
);

type Click = {
  id: string;
  click_id: string;
  campaign_id: string;
  status: string;
  created_at: string;
};

type Conversion = {
  id: string;
  conversion_id: string;
  click_id: string;
  campaign_id: string;
  reward: number;
  advertiser_payout: number;
  status: string;
  rejection_reason: string | null;
  created_at: string;
};

type Campaign = {
  id: string;
  name: string;
  image_url: string | null;
  category: string | null;
  reward: number;
  landing_url: string | null;
};

type Activity = {
  click: Click;
  conversion?: Conversion;
  campaign?: Campaign;
};

type Filter =
  | "all"
  | "completed"
  | "progress"
  | "cancelled";

export default function MyOffers() {
  const [loading, setLoading] = useState(true);
  const [items, setItems] = useState<Activity[]>([]);
  const [balance, setBalance] = useState(0);
  const [filter, setFilter] = useState<Filter>("all");

  useEffect(() => {
    load();
  }, []);

  async function load() {
    const {
      data: { user },
    } = await supabase.auth.getUser();

    if (!user) {
      window.location.replace("/login");
      return;
    }

    const [clicks, conversions, campaigns, profile] =
      await Promise.all([
        supabase
          .from("clicks")
          .select("id,click_id,campaign_id,status,created_at")
          .eq("user_id", user.id)
          .order("created_at", { ascending: false }),

        supabase
          .from("conversions")
          .select(
            "id,conversion_id,click_id,campaign_id,reward,advertiser_payout,status,rejection_reason,created_at"
          )
          .eq("user_id", user.id)
          .order("created_at", { ascending: false }),

        supabase
          .from("campaigns")
          .select("id,name,image_url,category,reward,landing_url"),

        supabase
          .from("profiles")
          .select("wallet_balance")
          .eq("id", user.id)
          .maybeSingle(),
      ]);

    const clickData = clicks.data || [];
    const conversionData = conversions.data || [];
    const campaignData = campaigns.data || [];

    const conversionMap = new Map(
      conversionData.map((x) => [x.click_id, x])
    );

    const campaignMap = new Map(
      campaignData.map((x) => [x.id, x])
    );

    setItems(
      clickData.map((click) => ({
        click,
        conversion: conversionMap.get(click.click_id),
        campaign: campaignMap.get(click.campaign_id),
      }))
    );

    setBalance(Number(profile.data?.wallet_balance || 0));
    setLoading(false);
  }

  const completed = items.filter((x) =>
    ["approved", "completed"].includes(
      x.conversion?.status || ""
    )
  );

  const progress = items.filter((x) =>
    ["clicked", "pending"].includes(
      x.conversion?.status || x.click.status
    )
  );

  const cancelled = items.filter((x) =>
    ["rejected", "fraud", "expired"].includes(
      x.conversion?.status || x.click.status
    )
  );

  const filtered = useMemo(() => {
    if (filter === "completed") return completed;
    if (filter === "progress") return progress;
    if (filter === "cancelled") return cancelled;
    return items;
  }, [filter, items, completed, progress, cancelled]);

  if (loading) {
    return (
      <>
        <style>{css}</style>
        <main className="loading">
          <b>AURA CAMP</b>
          <span>Loading your offers...</span>
        </main>
      </>
    );
  }

  return (
    <>
      <style>{css}</style>

      <main className="page">

        <header className="top">
          <button
            className="back"
            onClick={() =>
              (window.location.href = "/")
            }
          >
            ←
          </button>

          <div>
            <h1>My Offers</h1>
            <p>
              Track your offer progress and earnings
            </p>
          </div>

          <button
            className="search"
            onClick={() =>
              document
                .getElementById("offerSearch")
                ?.focus()
            }
          >
            ⌕
          </button>
        </header>

        <input
          id="offerSearch"
          className="searchInput"
          placeholder="Search your offers..."
          onChange={(e) => {
            const value =
              e.target.value.toLowerCase();

            document
              .querySelectorAll(".activityCard")
              .forEach((card) => {
                const text =
                  card.textContent?.toLowerCase() || "";

                (card as HTMLElement).style.display =
                  !value || text.includes(value)
                    ? ""
                    : "none";
              });
          }}
        />

        <section className="hero">
          <div className="heroRow">
            <span className="tracker">
              ✓ Offer tracker
            </span>

            <div className="heroIcon">◴</div>
          </div>

          <h2>Your offers activity</h2>

          <p>
            Progress, completions & wallet balance
          </p>

          <div className="summary">
            <Box
              value={items.length}
              label="Total"
            />

            <Box
              value={progress.length}
              label="Active"
            />

            <Box
              value={completed.length}
              label="Done"
            />

            <Box
              value={`₹${balance.toFixed(2)}`}
              label="Balance"
              purple
            />
          </div>
        </section>

        <div className="filters">
          <Filter
            active={filter === "all"}
            label="All"
            count={items.length}
            onClick={() => setFilter("all")}
          />

          <Filter
            active={filter === "completed"}
            label="Completed"
            count={completed.length}
            onClick={() => setFilter("completed")}
          />

          <Filter
            active={filter === "progress"}
            label="In Progress"
            count={progress.length}
            onClick={() => setFilter("progress")}
          />

          <Filter
            active={filter === "cancelled"}
            label="Cancelled"
            count={cancelled.length}
            onClick={() => setFilter("cancelled")}
          />
        </div>

        <div className="info">
          ⚡ Rewards are credited to your wallet after
          verification.
        </div>

        <section className="list">
          {filtered.length === 0 ? (
            <div className="empty">
              <div>🎁</div>
              <h3>No offer activity</h3>
              <p>
                Your offer activity will appear here.
              </p>
            </div>
          ) : (
            filtered.map((item) => (
              <OfferCard
                key={item.click.id}
                item={item}
              />
            ))
          )}
        </section>

        <nav className="bottom">
          <button
            onClick={() =>
              (window.location.href = "/")
            }
          >
            <span>⌂</span>
            <small>Home</small>
          </button>

          <button
            onClick={() =>
              (window.location.href = "/#offers")
            }
          >
            <span>▦</span>
            <small>Offers</small>
          </button>

          <button
            className="telegram"
            onClick={() =>
              (window.location.href =
                "https://t.me/Auracampaign")
            }
          >
            <span>✈</span>
            <small>Telegram</small>
          </button>

          <button className="active">
            <span>▤</span>
            <small>My Offers</small>
          </button>

          <button
            onClick={() =>
              (window.location.href = "/profile")
            }
          >
            <span>♙</span>
            <small>Profile</small>
          </button>
        </nav>

      </main>
    </>
  );
}

function Box({
  value,
  label,
  purple,
}: {
  value: string | number;
  label: string;
  purple?: boolean;
}) {
  return (
    <div>
      <strong className={purple ? "purple" : ""}>
        {value}
      </strong>
      <span>{label}</span>
    </div>
  );
}

function Filter({
  active,
  label,
  count,
  onClick,
}: {
  active: boolean;
  label: string;
  count: number;
  onClick: () => void;
}) {
  return (
    <button
      className={active ? "filter active" : "filter"}
      onClick={onClick}
    >
      {label}
      <span>{count}</span>
    </button>
  );
}

function OfferCard({
  item,
}: {
  item: Activity;
}) {
  const campaign = item.campaign;
  const conversion = item.conversion;

  const status =
    conversion?.status || item.click.status;

  const completed =
    status === "approved" ||
    status === "completed";

  const cancelled =
    status === "rejected" ||
    status === "fraud" ||
    status === "expired";

  const reward = Number(
    conversion?.reward ??
      campaign?.reward ??
      0
  );

  return (
    <article className="activityCard">

      <div className="offerHead">

        <div className="offerImage">
          {campaign?.image_url ? (
            <img
              src={campaign.image_url}
              alt={campaign.name}
            />
          ) : (
            <span>🎁</span>
          )}
        </div>

        <div className="offerTitle">
          <h3>
            {campaign?.name ||
              "Partner Offer"}
          </h3>

          <span>
            ◷ Clicked ·{" "}
            {formatDateTime(
              item.click.created_at
            )}
          </span>

          <span>
            ◇{" "}
            {campaign?.category ||
              "Partner offer"}
          </span>
        </div>

        <Status status={status} />
      </div>

      <div className="progressBox">

        <div className="progressTop">
          <strong>⛓ Step progress</strong>

          <span>
            {completed
              ? "Completed"
              : cancelled
              ? "Cancelled"
              : "Step 1 of 2"}
          </span>
        </div>

        <div className="progressLine">

          <i className="done">✓</i>

          <div className="line">
            <span
              className={
                completed ? "full" : ""
              }
            />
          </div>

          <i
            className={
              completed
                ? "done"
                : cancelled
                ? "cancel"
                : ""
            }
          >
            {completed
              ? "✓"
              : cancelled
              ? "×"
              : "2"}
          </i>

        </div>

      </div>

      <div className="offerFooter">

        <strong className="reward">
          +₹{reward.toFixed(2)}
          <small> C</small>
        </strong>

        {completed ? (
          <span className="credited">
            Reward credited ✓
          </span>
        ) : campaign?.landing_url ? (
          <button
            onClick={() =>
              (window.location.href =
                campaign.landing_url!)
            }
          >
            View offer →
          </button>
        ) : null}

      </div>

      {conversion?.rejection_reason && (
        <div className="reason">
          Reason: {conversion.rejection_reason}
        </div>
      )}
    </article>
  );
}

function Status({
  status,
}: {
  status: string;
}) {
  const s = status.toLowerCase();

  if (
    s === "approved" ||
    s === "completed"
  ) {
    return (
      <span className="status completed">
        Completed
      </span>
    );
  }

  if (
    s === "rejected" ||
    s === "fraud" ||
    s === "expired"
  ) {
    return (
      <span className="status cancelled">
        Cancelled
      </span>
    );
  }

  return (
    <span className="status progress">
      In Progress
    </span>
  );
}

function formatDateTime(value: string) {
  return new Date(value).toLocaleString(
    "en-IN",
    {
      day: "2-digit",
      month: "short",
      hour: "2-digit",
      minute: "2-digit",
    }
  );
}

